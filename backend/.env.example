PORT=3001
JWT_SECRET=kiro-platform-secret-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# S3-совместимое хранилище (reg.ru) — для аватарок пользователей
S3_ENDPOINT=https://s3.regru.cloud
S3_BUCKET=kirocamp
S3_PUBLIC_URL=https://kirocamp.s3.regru.cloud
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Отдел продаж в админке (CRM и календарь). Менеджеры — логин:пароль через запятую,
# им открыт только этот раздел. По умолчанию hasya — Саша, emildior — Эмиль
# (другие логины задаются SALES_SASHA и SALES_EMIL).
SALES_ADMINS=
# Логин Дениса; если пусто — Денисом считается учётная запись продюсера (PRODUCER_ADMINS)
SALES_DENIS=
